#!/usr/bin/env bash
set -Eeuo pipefail

exec > >(tee /var/log/app-bootstrap.log | logger -t app-bootstrap -s 2>/dev/console) 2>&1

readonly app_root="/opt/aws-secure-observability-platform"
readonly source_dir="$app_root/source"
readonly archive_path="/tmp/application.tar.gz"
readonly archive_url="https://github.com/danmondelice/aws-secure-observability-platform/archive/${application_git_ref}.tar.gz"

dnf install -y python3 python3-pip curl tar gzip

install -d -m 0755 "$source_dir"
curl --fail --silent --show-error --location --retry 5 --retry-delay 2 \
  --output "$archive_path" "$archive_url"
tar -xzf "$archive_path" --strip-components=1 -C "$source_dir"

python3 -m venv "$app_root/venv"
"$app_root/venv/bin/python" -m pip install --no-cache-dir \
  --requirement "$source_dir/app/requirements.txt"

id appsvc >/dev/null 2>&1 || useradd --system --home-dir "$app_root" --shell /sbin/nologin appsvc
chown -R appsvc:appsvc "$app_root"

cat > /etc/systemd/system/aws-secure-observability-app.service <<'UNIT'
[Unit]
Description=AWS Secure Observability Flask Application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=appsvc
Group=appsvc
WorkingDirectory=/opt/aws-secure-observability-platform/source
Environment=APP_BIND=0.0.0.0:${app_port}
Environment=ENABLE_FAILURE_ENDPOINTS=false
Environment=LOG_LEVEL=INFO
Environment=AWS_REGION=${aws_region}
Environment=DB_HOST=${database_host}
Environment=DB_PORT=${database_port}
Environment=DB_NAME=${database_name}
Environment=DB_SECRET_ARN=${database_secret_arn}
ExecStart=/opt/aws-secure-observability-platform/venv/bin/gunicorn --config app/gunicorn.conf.py app.app:app
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/aws-secure-observability-platform

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now aws-secure-observability-app.service
